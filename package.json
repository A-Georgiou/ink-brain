{
  "name": "ink-brain",
  "productName": "Ink Brain",
  "version": "0.2.0",
  "private": true,
  "description": "An always-on companion for your Mac, built on GitHub Copilot: circle anything on screen, ask out loud, and it explains with sketches, motion graphics and 3D.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-Georgiou/ink-brain.git"
  },
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "start": "npm run build:helper --silent && electron .",
    "build:helper": "bash native/build.sh",
    "doctor": "npm run build:helper --silent && node scripts/doctor.mjs",
    "extension:install": "node scripts/install-extension.mjs",
    "extension:uninstall": "node scripts/install-extension.mjs --uninstall",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint .",
    "eval:capture": "electron evals/capture.mjs",
    "eval": "electron evals/run.mjs",
    "eval:report": "node evals/report.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.28",
    "d3": "^7.9.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "kokoro-js": "^1.2.1",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "roughjs": "^4.6.6",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "overrides": {
    "zod": "^4.6.6",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "koffi": false,
    "onnxruntime-node": false,
    "sharp": false,
    "protobufjs": false
  }
}
